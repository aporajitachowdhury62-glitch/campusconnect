# Database Configuration (SQLite by default, easily swapped with PostgreSQL)
DATABASE_URL=sqlite:///./campusconnect.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/campusconnect

# Server Port and Host
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# MCP (Model Context Protocol) API Key for Bearer Auth
MCP_API_KEY=campusconnect-secret-mcp-key
